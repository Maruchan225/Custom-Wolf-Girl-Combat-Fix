<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GirlPoolCombatFix</AssemblyName>
    <RootNamespace>GirlPoolCombatFix</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <Import Project="GirlPoolCombatFix.local.props" Condition="Exists('GirlPoolCombatFix.local.props')" />

  <Target Name="ValidateGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GamePath)' == ''" Text="Set GamePath to the Family Time installation directory, using -p:GamePath or GirlPoolCombatFix.local.props." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamePath)\FamilyTime_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(GamePath)\FamilyTime_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GamePath)\FamilyTime_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
